{
  "rewrites": [
    { "source": "/mcp/:key", "destination": "/api/mcp?key=:key" },
    { "source": "/mcp", "destination": "/api/mcp" }
  ],
  "functions": {
    "api/sync.mjs": { "maxDuration": 60 },
    "api/daten.mjs": { "maxDuration": 20 },
    "api/mcp.mjs": { "maxDuration": 30 },
    "api/einstellungen.mjs": { "maxDuration": 10 },
    "api/protokoll.mjs": { "maxDuration": 10 },
    "api/ki-coach.mjs": { "maxDuration": 300 },
    "api/fotos.mjs": { "maxDuration": 300 },
    "api/import.mjs": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
      ]
    },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
